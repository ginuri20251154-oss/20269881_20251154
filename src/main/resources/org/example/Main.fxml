<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.MainFXController"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <Label text="Inventory Management System"
               maxWidth="Infinity"
               style="-fx-font-size: 22px;
                      -fx-font-weight: bold;
                      -fx-padding: 15;
                      -fx-alignment: center;" />
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <tabs>

                <!-- Inventory Tab -->
                <Tab text="Inventory"
                     closable="false">

                    <BorderPane>

                        <center>
                            <TableView fx:id="inventoryTable">

                                <columns>

                                    <TableColumn fx:id="partCodeColumn"
                                                 text="Part Code"
                                                 prefWidth="100" />

                                    <TableColumn fx:id="partNameColumn"
                                                 text="Part Name"
                                                 prefWidth="160" />

                                    <TableColumn fx:id="brandColumn"
                                                 text="Brand"
                                                 prefWidth="120" />

                                    <TableColumn fx:id="categoryColumn"
                                                 text="Category"
                                                 prefWidth="120" />

                                    <TableColumn fx:id="priceColumn"
                                                 text="Price"
                                                 prefWidth="100" />

                                    <TableColumn fx:id="quantityColumn"
                                                 text="Quantity"
                                                 prefWidth="100" />

                                    <TableColumn fx:id="stockDateColumn"
                                                 text="Stock Date"
                                                 prefWidth="120" />

                                    <TableColumn fx:id="thresholdColumn"
                                                 text="Low Stock Threshold"
                                                 prefWidth="150" />
                                    <TableColumn fx:id="imageColumn"
                                                 text="Image"
                                                 prefWidth="90" />

                                </columns>

                            </TableView>
                        </center>

                        <bottom>
                            <VBox spacing="10"
                                  style="-fx-padding: 15;">

                                <HBox spacing="20"
                                      alignment="CENTER_LEFT">

                                    <Label text="Total Parts:" />

                                    <Label fx:id="totalPartsLabel"
                                           text="0" />

                                    <Label text="Total Inventory Value:" />

                                    <Label fx:id="totalValueLabel"
                                           text="0.00" />

                                </HBox>

                                <HBox spacing="10"
                                      alignment="CENTER">

                                    <Button fx:id="addPartButton"
                                            text="Add Part" onAction="#handleAddPart" />

                                    <Button fx:id="updatePartButton"
                                            text="Update Part" onAction="#handleUpdatePart"  />

                                    <Button fx:id="deletePartButton"
                                            text="Delete Part" onAction="#handleDeletePart" />

                                </HBox>

                            </VBox>
                        </bottom>

                    </BorderPane>

                </Tab>

                <!-- Search Tab -->
                <Tab text="Search"
                      closable="false">

                <BorderPane>

                    <top>
                        <VBox spacing="10"
                              style="-fx-padding: 15;">

                            <Label text="Search Inventory"
                                   style="-fx-font-size: 18px;
                              -fx-font-weight: bold;" />

                            <HBox spacing="10">

                                <TextField fx:id="searchPartCodeField"
                                           promptText="Part Code" />

                                <TextField fx:id="searchPartNameField"
                                           promptText="Part Name" />

                                <TextField fx:id="searchBrandField"
                                           promptText="Brand" />

                                <TextField fx:id="searchCategoryField"
                                           promptText="Category" />

                            </HBox>

                            <HBox spacing="10">

                                <TextField fx:id="searchMinPriceField"
                                           promptText="Minimum Price" />

                                <TextField fx:id="searchMaxPriceField"
                                           promptText="Maximum Price" />

                                <Button text="Search"
                                        onAction="#handleSearchInventory" />

                                <Button text="Reset"
                                        onAction="#handleResetSearch" />

                            </HBox>

                        </VBox>
                    </top>

                    <center>
                        <TableView fx:id="searchResultsTable">

                            <columns>

                                <TableColumn fx:id="searchPartCodeColumn"
                                             text="Part Code"
                                             prefWidth="100" />

                                <TableColumn fx:id="searchPartNameColumn"
                                             text="Part Name"
                                             prefWidth="160" />

                                <TableColumn fx:id="searchBrandColumn"
                                             text="Brand"
                                             prefWidth="120" />

                                <TableColumn fx:id="searchCategoryColumn"
                                             text="Category"
                                             prefWidth="120" />

                                <TableColumn fx:id="searchPriceColumn"
                                             text="Price"
                                             prefWidth="100" />

                                <TableColumn fx:id="searchQuantityColumn"
                                             text="Quantity"
                                             prefWidth="100" />
                                <TableColumn fx:id="searchImageColumn"
                                             text="Image"
                                             prefWidth="90" />

                            </columns>

                        </TableView>
                    </center>

                </BorderPane>

            </Tab>
                <!-- Low Stock Tab -->
                <Tab text="Low Stock" closable="false">

                    <BorderPane>

                        <top>
                            <HBox spacing="10"
                                  style="-fx-padding: 15;">

                                <Label text="Low Stock Items"
                                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;" />

                                <Button text="Refresh"
                                        onAction="#handleRefreshLowStock" />

                            </HBox>
                        </top>

                        <center>
                            <TableView fx:id="lowStockTable">

                                <columns>

                                    <TableColumn fx:id="lowStockPartCodeColumn"
                                                 text="Part Code"
                                                 prefWidth="100" />

                                    <TableColumn fx:id="lowStockPartNameColumn"
                                                 text="Part Name"
                                                 prefWidth="160" />

                                    <TableColumn fx:id="lowStockBrandColumn"
                                                 text="Brand"
                                                 prefWidth="120" />

                                    <TableColumn fx:id="lowStockCategoryColumn"
                                                 text="Category"
                                                 prefWidth="120" />

                                    <TableColumn fx:id="lowStockQuantityColumn"
                                                 text="Quantity"
                                                 prefWidth="100" />

                                    <TableColumn fx:id="lowStockThresholdColumn"
                                                 text="Threshold"
                                                 prefWidth="110" />

                                </columns>

                            </TableView>
                        </center>

                    </BorderPane>

                </Tab>
                <!-- Dealers Tab -->
                <Tab text="Dealers" closable="false">

                    <BorderPane>

                        <top>
                            <HBox spacing="10"
                                  style="-fx-padding: 15;">

                                <Label text="Random Dealer Selection"
                                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;" />

                                <Button text="Select Dealers"
                                        onAction="#handleSelectDealers" />

                            </HBox>
                        </top>

                        <center>
                            <TableView fx:id="dealerTable">

                                <columns>

                                    <TableColumn fx:id="dealerNameColumn"
                                                 text="Dealer Name"
                                                 prefWidth="220" />

                                    <TableColumn fx:id="dealerLocationColumn"
                                                 text="Location"
                                                 prefWidth="180" />

                                    <TableColumn fx:id="dealerPhoneColumn"
                                                 text="Phone Number"
                                                 prefWidth="180" />

                                </columns>

                            </TableView>
                        </center>

                    </BorderPane>

                </Tab>

                <!-- Point of Sale Tab -->
                <Tab text="Point Of Sale" closable="false">

                    <BorderPane>

                        <top>
                            <VBox spacing="10"
                                  style="-fx-padding: 15;">

                                <Label text="Point of Sale"
                                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;" />

                                <HBox spacing="10">

                                    <TextField fx:id="posPartCodeField"
                                               promptText="Part Code" />

                                    <TextField fx:id="posQuantityField"
                                               promptText="Quantity" />

                                    <Button text="Add to Cart"
                                            onAction="#handleAddToCart" />

                                </HBox>

                            </VBox>
                        </top>

                        <center>
                            <TableView fx:id="cartTable">

                                <columns>

                                    <TableColumn fx:id="cartPartCodeColumn"
                                                 text="Part Code"
                                                 prefWidth="100" />

                                    <TableColumn fx:id="cartPartNameColumn"
                                                 text="Part Name"
                                                 prefWidth="180" />

                                    <TableColumn fx:id="cartQuantityColumn"
                                                 text="Quantity"
                                                 prefWidth="100" />

                                    <TableColumn fx:id="cartPriceColumn"
                                                 text="Unit Price"
                                                 prefWidth="100" />

                                    <TableColumn fx:id="cartSubtotalColumn"
                                                 text="Subtotal"
                                                 prefWidth="120" />

                                </columns>

                            </TableView>
                        </center>

                        <bottom>
                            <VBox spacing="10"
                                  style="-fx-padding: 15;">

                                <HBox spacing="20">

                                    <Label text="Cart Total:"
                                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;" />

                                    <Label fx:id="cartTotalLabel"
                                           text="0.00"
                                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;" />

                                </HBox>

                                <HBox spacing="10">

                                    <Button text="Remove Selected Item"
                                            onAction="#handleRemoveCartItem" />

                                    <Button text="Clear Cart"
                                            onAction="#handleClearCart" />

                                    <Button text="Checkout"
                                            onAction="#handleCheckout" />

                                </HBox>

                            </VBox>
                        </bottom>

                    </BorderPane>

                </Tab>
            </tabs>

        </TabPane>
    </center>


</BorderPane>
